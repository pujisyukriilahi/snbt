{
  "version": "2.0",
  "note": "SNBT Readiness Check is an initial self-assessment. It estimates learning needs before a baseline TO and must not be presented as a predicted SNBT score.",
  "assessment": {
    "total_questions": 21,
    "scale": "1-5",
    "dimensions": {
      "academic": {"weight": 0.40, "questions": 6},
      "subtest": {"weight": 0.30, "questions": 7},
      "learning_capability": {"weight": 0.20, "questions": 4},
      "strategy": {"weight": 0.10, "questions": 4}
    },
    "target_pressure": "modifier_not_readiness"
  },
  "severity": {
    "1": 4,
    "2": 3,
    "3": 2,
    "4": 1,
    "5": 0
  },
  "target_pressure": {
    "baseline_gte_730": 5,
    "baseline_gte_700": 4,
    "baseline_gte_670": 3,
    "baseline_gte_630": 2,
    "baseline_lt_630": 1,
    "class_12_bonus": 1,
    "maximum": 5
  },
  "study_plan": {
    "minimum_sessions": 2,
    "maximum_sessions": 64,
    "checkpoint_every": 8,
    "session_unit": "1 pertemuan = 1 primary subtest",
    "anti_consecutive_same_subtest": true,
    "allocation": "severity_weighted",
    "ordering": "weighted_interleaving",
    "baseline_note": "After the initial learning cycle, a baseline TO should replace self-assessment as the primary evidence and move the student to TO Gap Check.",
    "session_ranges": [
      {"min": 2, "max": 4, "label": "Self-study + Check-in"},
      {"min": 4, "max": 8, "label": "Guided Foundation"},
      {"min": 8, "max": 16, "label": "Guided Development"},
      {"min": 16, "max": 28, "label": "Intensive Development"},
      {"min": 28, "max": 40, "label": "Intensive Targeted"},
      {"min": 40, "max": 64, "label": "Intensive Priority"}
    ],
    "focus_rules": {
      "2_4_sessions": "2-3 priority subtests",
      "5_8_sessions": "3-4 priority subtests",
      "9_16_sessions": "4-5 priority subtests",
      "17_plus_sessions": "all subtests may appear according to weighted allocation"
    }
  },
  "ethics": {
    "allow_low_need_result": true,
    "allow_no_tutoring_result": true,
    "product_must_follow_diagnosis": true,
    "no_forced_package_size": true
  }
}
